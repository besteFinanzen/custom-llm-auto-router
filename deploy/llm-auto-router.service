[Unit]
Description=llm-auto-router gateway (OpenAI-compatible model router)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=%h/llm-auto-router
ExecStart=%h/llm-auto-router/.venv/bin/uvicorn gateway:app --host 127.0.0.1 --port 4141
Restart=on-failure
RestartSec=3
Environment=PYTHONUNBUFFERED=1

[Install]
WantedBy=default.target
