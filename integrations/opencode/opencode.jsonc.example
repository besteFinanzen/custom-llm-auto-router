// Example OpenCode configuration for llm-auto-router.
//
// Merge the `providers.router` block (and the plugin entry) into your own
// ~/.config/opencode/opencode.jsonc. Adjust the baseURL if the gateway runs on
// another host or port (default: http://127.0.0.1:4141/v1).
//
// The gateway requires a bearer key on /v1/*: set `settings.apiKey` to a
// router-scoped API key (generated in the Worktracker UI or via `ROUTER_API_KEY`).
// OpenCode sends it as `Authorization: Bearer <key>` on every request.
// Upstream provider keys are configured in the gateway's .env, not here.
{
  "$schema": "https://opencode.ai/config.json",

  // `./plugins/router-tags` is relative to ~/.config/opencode — copy the bundled
  // plugin from integrations/opencode/plugins/router-tags there.
  "plugins": ["./plugins/router-tags"],

  "providers": {
    "router": {
      "name": "Auto Router (llm-auto-router)",
      "package": "@opencode/ai/providers/openai-compatible",
      "settings": {
        "baseURL": "https://tracker.nizent.de/v1",
        "apiKey": "wt_<8hex-prefix>_<32-byte-secret>"
      },
      "models": {
        "low": {
          "name": "Router Low (~free)",
          "limit": { "context": 131072, "output": 32000 },
          "capabilities": { "tools": true, "input": ["text"], "output": ["text"] }
        },
        "medium": {
          "name": "Router Medium (<=$0.60/1M)",
          "limit": { "context": 131072, "output": 32000 },
          "capabilities": { "tools": true, "input": ["text"], "output": ["text"] }
        },
        "high": {
          "name": "Router High (<=$5/1M)",
          "limit": { "context": 200000, "output": 32000 },
          "capabilities": { "tools": true, "input": ["text"], "output": ["text"] }
        },
        "orchestrator": {
          "name": "Router Orchestrator (<=$5/1M, agentic)",
          "limit": { "context": 200000, "output": 32000 },
          "capabilities": { "tools": true, "input": ["text"], "output": ["text"] }
        },
        "coder": {
          "name": "Router Coder (<=$2/1M)",
          "limit": { "context": 131072, "output": 32768 },
          "capabilities": { "tools": true, "input": ["text"], "output": ["text"] }
        }
      }
    }
  }
}
