# llm-auto-router example environment.
#
# Copy to `.env` (which is gitignored; keep it chmod 600) and fill in the keys
# you have. The gateway loads this file at startup and any provider whose key is
# empty is DISABLED automatically — so you can start with just one key.
#
#   cp .env.example .env

# Where to get each key:
#   E_INFRA_API_KEY     e-Infra CZ LLM portal (https://llm.ai.e-infra.cz) — endpoint returns 401 without it
#   OPENCODE_API_KEY    https://opencode.ai/console -> API -> Personal API keys
#                       (required even for the free models; calls from outside the OpenCode client get 403)
#   OPENROUTER_API_KEY  https://openrouter.ai/keys (covers free AND paid models; credits checked via /auth/key)
#   DEEPSEEK_API_KEY    https://platform.deepseek.com/api_keys (paid; balance checked via /user/balance)
#   GEMINI_API_KEY      https://aistudio.google.com/apikey (Google AI Studio / Gemini)
#   AA_API_KEY          https://artificialanalysis.ai (free signup; ~100 req/day; used by refresh.py for benchmark ranks)

E_INFRA_API_KEY=
OPENCODE_API_KEY=
OPENROUTER_API_KEY=
DEEPSEEK_API_KEY=
GEMINI_API_KEY=
AA_API_KEY=

# Optional durable usage, project history and human/AI work tracking. Any normal
# PostgreSQL URL is accepted (local, managed, or external; sslmode is supported).
# DATABASE_URL=postgresql://router:password@127.0.0.1:55432/router
# ROUTER_DATABASE_URL is a backward-compatible alias. `deploy/setup-postgres.sh`
# provisions an optional local Docker database. See deploy/DOKPLOY.md for hosting.
# DATABASE_URL=

# Optional custom runtime paths (Docker defaults ROUTER_STATE_DIR to /data).
# ROUTER_CONFIG_DIR=
# ROUTER_STATE_DIR=
# ROUTER_HOST=127.0.0.1
# PORT=4141

# Optional. Command used to resolve OpenCode session IDs to human titles for the
# dashboard. Defaults to `opencode api get /api/session`; set to an empty value
# to disable title resolution entirely (e.g. in tests or headless deploys).
# ROUTER_TITLES_CMD=opencode api get /api/session

# --------------------------------------------------------------- Work tracker
# One image serves both roles; pick the mode:
#   all      (default) router + tracker in one process — recommended on Dokploy
#   router   router only; forwards usage + budget checks to TRACKER_REMOTE_URL
#   tracker  tracker only (no model routing); serves the UI and WakaTime API
# APP_MODE=all

# Tracker storage. Often the same URL as DATABASE_URL above; may point at a
# dedicated analytics database. Leave empty to disable tracking entirely.
# TRACKER_DATABASE_URL=postgresql://router:password@[IP_ADDRESS]:55432/router

# Scopes: admin > editor/hook > read. The UI dashboard needs read; edits need an
# admin (or editor) token. An empty value means that scope is not required.
# TRACKER_ADMIN_TOKEN=
# TRACKER_EDITOR_KEY=
# TRACKER_HOOK_TOKEN=
# TRACKER_READ_TOKEN=

# Attribution: warn (record but allow, default), enforce (400 on missing fields),
# or off (store usage without commit attribution).
# TRACKER_ATTRIBUTION_MODE=warn

# Session/heartbeat timing (seconds) and IANA timezone for day/week bucketing.
# TRACKER_TIMEZONE=Europe/Berlin
# TRACKER_IDLE_TIMEOUT_SECONDS=900
# TRACKER_HEARTBEAT_SECONDS=120
# TRACKER_PRESENCE_TTL_SECONDS=300

# Keep history forever by default; set a positive day count to prune old rows.
# TRACKER_RETENTION_DAYS=0

# Shorten file paths in the UI (default true); disable for local debugging.
# TRACKER_REDACT_PATHS=true

# Budgets: fail_closed blocks requests when the budget backend is unreachable
# (default false = fail open); cache TTL in seconds for budget checks.
# TRACKER_BUDGET_FAIL_CLOSED=false
# TRACKER_BUDGET_CACHE_SECONDS=5

# Public URL of the tracker, printed by the curl git-hook installer. Empty means
# derive it from the request host.
# TRACKER_PUBLIC_URL=

# Split deployments (APP_MODE=router): where to forward usage events and run
# budget checks against the remote tracker, plus an optional bearer token
# (falls back to TRACKER_HOOK_TOKEN / TRACKER_EDITOR_KEY / TRACKER_ADMIN_TOKEN).
# TRACKER_REMOTE_URL=
